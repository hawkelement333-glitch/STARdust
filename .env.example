# VYRL Studio Environment Variables

# Public URL for media serving (required for live platform posting)
PUBLIC_BASE_URL=https://your-domain.com

# TikTok
TIKTOK_ACCESS_TOKEN=your_tiktok_token_here
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Instagram / Meta
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
INSTAGRAM_ACCOUNT_ID=your_account_id
META_GRAPH_VERSION=v20.0

# YouTube
YOUTUBE_ACCESS_TOKEN=your_youtube_token

# Webhook (e.g., Make/Zapier)
VYRL_PUBLISH_WEBHOOK_URL=https://your-webhook-endpoint
VYRL_WEBHOOK_SECRET=optional_secret

# FFmpeg for video rendering (YouTube etc.)
FFMPEG_PATH=/usr/bin/ffmpeg

# Server
HOST=0.0.0.0
PORT=4173
